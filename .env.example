# =================================================================
# BlockVerify - Environment Configuration Template
# =================================================================

# Database (PostgreSQL URL in production, or SQLite for local)
DATABASE_URL=postgresql://user:password@localhost:5432/blockverify_db

# JWT & Security
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ethereum Blockchain - Sepolia Testnet
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
DEPLOYER_PRIVATE_KEY=YOUR_ETHEREUM_SEPOLIA_PRIVATE_KEY_WITHOUT_0X
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# IPFS Pinning Service (Pinata Cloud)
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_API_KEY=YOUR_PINATA_API_SECRET
PINATA_JWT=YOUR_PINATA_JWT_TOKEN
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Public Web Application URLs
FRONTEND_URL=https://blockverify.vercel.app
API_BASE_URL=https://blockverify-api.onrender.com/api
